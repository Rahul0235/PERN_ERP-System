{
  "info": {"name":"PERN ERP API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:8080/api"},{"key":"token","value":""},{"key":"enquiryId","value":"1"},{"key":"quotationId","value":"1"},{"key":"orderId","value":"1"}],
  "item":[
    {"name":"Login (Sales)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/auth/login","body":{"mode":"raw","raw":"{\"email\":\"sales@example.com\",\"password\":\"Sales@123\"}"}},"event":[{"listen":"test","script":{"exec":["const body = pm.response.json(); if (body.token) pm.collectionVariables.set('token', body.token);"]}}]},
    {"name":"Products","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/products"}},
    {"name":"Inventory","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/inventory"}},
    {"name":"Create enquiry","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/enquiries","body":{"mode":"raw","raw":"{\"customer\":{\"companyName\":\"ABC Engineering Pvt Ltd\",\"contactPerson\":\"Asha Shah\",\"mobile\":\"9876543210\",\"email\":\"asha@example.com\",\"city\":\"Pune\"},\"notes\":\"Demo enquiry\",\"items\":[{\"productId\":1,\"quantity\":10}]}"}}},
    {"name":"List enquiries","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/enquiries"}},
    {"name":"Create quotation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/quotations","body":{"mode":"raw","raw":"{\"enquiryId\":{{enquiryId}},\"items\":[{\"productId\":1,\"quantity\":10,\"discountPct\":0,\"gstPct\":18}]}"}}},
    {"name":"List quotations","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/quotations"}},
    {"name":"Mark quotation SENT","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/quotations/{{quotationId}}/status","body":{"mode":"raw","raw":"{\"status\":\"SENT\"}"}}},
    {"name":"Accept quotation","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/quotations/{{quotationId}}/status","body":{"mode":"raw","raw":"{\"status\":\"ACCEPTED\"}"}}},
    {"name":"Convert quotation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/quotations/{{quotationId}}/convert"}},
    {"name":"List sales orders","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/sales-orders"}}
  ]
}
